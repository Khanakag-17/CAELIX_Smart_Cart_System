# Firebase credentials — never commit a real service account key.
# The placeholder already tracked in CAELIX_Theft_Detectors/ stays tracked;
# this prevents any new key from being added by accident.
serviceAccountKey.json
**/serviceAccountKey.json
*-firebase-adminsdk-*.json

# Environment and secrets
.env
.env.*
!.env.example
secrets/

